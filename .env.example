# Opcional: si defines una contraseña, el área privada (/admin) la pedirá.
# Si la dejas vacía, el área privada queda abierta (útil solo en localhost).
ADMIN_PASSWORD=

# Tienda de Amazon para los enlaces de compra (amazon.com, amazon.es, amazon.com.mx…).
AMAZON_DOMAIN=amazon.com
# Etiqueta de Amazon Afiliados (p. ej. micuento-20). Si se define, se añade a todos
# los enlaces de Amazon y se muestra el aviso de afiliada.
AMAZON_TAG=
